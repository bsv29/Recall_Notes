# Copy to .env and change the values.
# SQLite works out of the box; for PostgreSQL use:
# DATABASE_URL=postgresql+psycopg://recall:recall@localhost:5432/recall
DATABASE_URL=sqlite:///./recall.db

# Generate a long random secret, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_DAYS=30

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000
